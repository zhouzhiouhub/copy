<Window x:Class="ClipboardAtlas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipboardAtlas"
        Title="kinolincopy"
        Width="280"
        Height="580"
        MinWidth="280"
        MaxWidth="280"
        MinHeight="580"
        MaxHeight="580"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F7F8F5"
        FontFamily="Microsoft YaHei, Segoe UI, Arial"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/assets/logo64.png">
  <Window.Resources>
    <local:BoolVis x:Key="Vis"/>
    <local:BoolVis x:Key="InvVis" Invert="True"/>
    <local:NullVis x:Key="NullVis"/>
    <local:TypeIcon x:Key="TypeIcon"/>
    <local:FileMeta x:Key="FileMeta"/>
    <local:PathImage x:Key="PathImage"/>

    <SolidColorBrush x:Key="Ink" Color="#18221F"/>
    <SolidColorBrush x:Key="Muted" Color="#69766F"/>
    <SolidColorBrush x:Key="Line" Color="#DCE2DB"/>
    <SolidColorBrush x:Key="Paper" Color="#FFFFFF"/>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#69766F"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#EDF1EB"/>
                <Setter Property="Foreground" Value="#17201D"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FDE8E2"/>
                <Setter Property="Foreground" Value="#A45134"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MenuItem" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F3F3F3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WideDangerButton" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="#FDE8E2"/>
      <Setter Property="Foreground" Value="#A45134"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F8D6CD"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" Background="#F7F8F5">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Padding" Value="6,0,0,0"/>
        <Setter Property="BorderBrush" Value="#24332E"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding DockSide}" Value="left">
            <Setter Property="Padding" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Width="6" VerticalAlignment="Stretch" Panel.ZIndex="8">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="-6,0,0,0"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding DockSide}" Value="left">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,-6,0"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#24332E" Offset="0"/>
            <GradientStop Color="#49675C" Offset="0.42"/>
            <GradientStop Color="#F1C95A" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Border Width="4" Height="52" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#B8FFFFFF"/>
      </Border>

      <Border Grid.Row="0" Background="#F2FCFDF9" BorderBrush="#DCE2DB" BorderThickness="0,0,0,1" MouseLeftButtonDown="TopbarDrag">
        <DockPanel Margin="6,0">
          <Border Width="20" Height="20" CornerRadius="6" Background="#08152D" DockPanel.Dock="Left" VerticalAlignment="Center" ClipToBounds="True">
            <Image Source="pack://application:,,,/assets/logo64.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <UniformGrid Rows="1" Margin="4,0,0,0">
            <Button ToolTip="{Binding PauseTip}" Click="TogglePaused">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Paused}" Value="True">
                      <Setter Property="Foreground" Value="#A45134"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="{Binding PauseIcon}"/>
            </Button>
            <Button Style="{StaticResource DangerButton}" ToolTip="清空未锁定记录" Click="ClearEntries">
              <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
            </Button>
            <Button Style="{StaticResource IconButton}" ToolTip="{Binding SideTip}" Click="SwitchSide">
              <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Text="{Binding SideIcon}"/>
            </Button>
            <Button Style="{StaticResource IconButton}" ToolTip="{Binding PinTip}" Click="TogglePinned">
              <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="{Binding PinIcon}"/>
            </Button>
            <Button Style="{StaticResource IconButton}" ToolTip="{Binding PrivacyTip}" Click="TogglePrivacy">
              <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="{Binding PrivacyIcon}"/>
            </Button>
            <Button Style="{StaticResource IconButton}" ToolTip="设置" Click="ToggleSettings">
              <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
            </Button>
            <Button Style="{StaticResource IconButton}" ToolTip="收起到边缘" Click="Collapse">
              <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
            </Button>
          </UniformGrid>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Padding="7,7,8,6" Visibility="{Binding PrivacyLocked, Converter={StaticResource InvVis}}">
        <Border Height="28" BorderBrush="#D8E0D7" BorderThickness="1" CornerRadius="8" Background="White">
          <DockPanel Margin="7,0">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#7B8780" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <TextBlock Text="{Binding CountText}" Foreground="#65736C" FontSize="10" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="6,0,0,0"/>
            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="11" Foreground="#1F2925" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.Style>
                <Style TargetType="TextBox">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="TextBox">
                        <Grid>
                          <TextBlock Text="搜索" Foreground="#9AA59E" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Grid>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </TextBox.Style>
            </TextBox>
          </DockPanel>
        </Border>
      </Border>

      <Grid Grid.Row="2">
        <Border Background="#F0F4EF" BorderBrush="#DCE2DB" BorderThickness="0,1,0,0" Visibility="{Binding PrivacyLocked, Converter={StaticResource InvVis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
            <ItemsControl ItemsSource="{Binding VisibleEntries}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ClipEntry}">
                  <Border Margin="0,0,0,6" Padding="8,8,6,8" CornerRadius="6" Cursor="Hand" MouseEnter="CardEnter" MouseLeftButtonUp="CardCopy">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#DCE2DB"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#B8C7BF"/>
                            <Setter Property="Background" Value="#FBFCFA"/>
                          </Trigger>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="#4CC2FF"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1" VerticalAlignment="Top">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#CDD8D1"/>
                            <Setter Property="Background" Value="#F7F8F5"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#263630"/>
                                <Setter Property="Background" Value="#263630"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" Text="{Binding TypeClass, Converter={StaticResource TypeIcon}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#2F7256"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="image">
                                  <Setter Property="Foreground" Value="#356A9E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="video">
                                  <Setter Property="Foreground" Value="#AD5A3E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="file">
                                  <Setter Property="Foreground" Value="#8B6B22"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="Foreground" Value="#F4D25F"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>

                      <StackPanel Grid.Column="1" Margin="6,0,6,0">
                        <DockPanel LastChildFill="False">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DateText}" FontSize="12" FontWeight="Bold" Foreground="#15201C"/>
                            <TextBlock Text="{Binding ClockText}" FontSize="12" FontWeight="Bold" Foreground="#15201C" Margin="6,0,0,0"/>
                            <TextBlock Text="锁定" FontSize="9" FontWeight="Bold" Foreground="#8B6B22" Margin="4,2,0,0" Visibility="{Binding Locked, Converter={StaticResource Vis}}"/>
                          </StackPanel>
                          <Border DockPanel.Dock="Right" CornerRadius="10" Padding="6,3" HorizontalAlignment="Right">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="#E7F6EE"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Type}" Value="image">
                                    <Setter Property="Background" Value="#E7F0FA"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Type}" Value="video">
                                    <Setter Property="Background" Value="#FFF0E9"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Type}" Value="file">
                                    <Setter Property="Background" Value="#FFF6D9"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock FontFamily="{StaticResource IconFont}" FontSize="9" Text="{Binding TypeClass, Converter={StaticResource TypeIcon}}" VerticalAlignment="Center" Margin="0,0,3,0">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2F7256"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Type}" Value="image">
                                        <Setter Property="Foreground" Value="#356A9E"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Type}" Value="video">
                                        <Setter Property="Foreground" Value="#AD5A3E"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Type}" Value="file">
                                        <Setter Property="Foreground" Value="#8B6B22"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2F7256"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Type}" Value="image">
                                        <Setter Property="Foreground" Value="#356A9E"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Type}" Value="video">
                                        <Setter Property="Foreground" Value="#AD5A3E"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Type}" Value="file">
                                        <Setter Property="Foreground" Value="#8B6B22"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                          </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#26332E" TextTrimming="CharacterEllipsis" Visibility="{Binding ShowTitle, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding Text}" FontSize="11" LineHeight="15.4" Foreground="#1E2925" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="46" Margin="0,2,0,0" Visibility="{Binding IsText, Converter={StaticResource Vis}}"/>
                        <Image Source="{Binding MediaPath, Converter={StaticResource PathImage}}" MaxHeight="82" Margin="0,3,0,0" Stretch="Uniform" Visibility="{Binding IsImage, Converter={StaticResource Vis}}"/>
                        <MediaElement Source="{Binding MediaUri}" MaxHeight="82" Margin="0,3,0,0" Stretch="Uniform" LoadedBehavior="Manual" ScrubbingEnabled="True" UnloadedBehavior="Manual" MediaOpened="VideoOpened" MouseLeftButtonUp="VideoClick" Visibility="{Binding IsVideo, Converter={StaticResource Vis}}"/>
                        <Border Margin="0,6,0,0" Padding="10" Visibility="{Binding ShowPlaceholder, Converter={StaticResource Vis}}">
                          <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#75827B" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Files}" Margin="0,6,0,0" Visibility="{Binding HasFiles, Converter={StaticResource Vis}}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:FileRecord}">
                              <Button Click="OpenFile" Tag="{Binding Path}" Margin="0,0,0,4" HorizontalContentAlignment="Stretch" Background="White" BorderBrush="#DCE2DB" BorderThickness="1" Cursor="Hand" Padding="6,5">
                                <Button.Template>
                                  <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="White" BorderBrush="#DCE2DB" BorderThickness="1" CornerRadius="8" Padding="6,5">
                                      <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#AABBB1"/>
                                        <Setter TargetName="bd" Property="Background" Value="#F2F7F3"/>
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Button.Template>
                                <DockPanel>
                                  <TextBlock DockPanel.Dock="Right" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#4F5D56" VerticalAlignment="Center"/>
                                  <Border Width="20" Height="20" CornerRadius="7" Margin="0,0,6,0">
                                    <Border.Style>
                                      <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EEF3EF"/>
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding Kind}" Value="image">
                                            <Setter Property="Background" Value="#E7F0FA"/>
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding Kind}" Value="video">
                                            <Setter Property="Background" Value="#FFF0E9"/>
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding Kind}" Value="folder">
                                            <Setter Property="Background" Value="#FFF6D9"/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Border.Style>
                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" Text="{Binding Kind, Converter={StaticResource TypeIcon}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Border>
                                  <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#17201D" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Converter={StaticResource FileMeta}}" FontSize="9" Foreground="#7A8780"/>
                                  </StackPanel>
                                </DockPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" Click="ToggleMenu" ToolTip="更多操作">
                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                      </Button>

                      <Border Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,0,0" Padding="6" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="8" Panel.ZIndex="6" Visibility="{Binding IsMenuOpen, Converter={StaticResource Vis}}">
                        <Border.Effect>
                          <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.16"/>
                        </Border.Effect>
                        <StackPanel Width="126">
                          <Button Style="{StaticResource MenuItem}" Click="ToggleLock">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,6,0">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE72E;"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Locked}" Value="True">
                                        <Setter Property="Text" Value="&#xE785;"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <TextBlock Text="{Binding LockLabel}"/>
                            </StackPanel>
                          </Button>
                          <Button Style="{StaticResource MenuItem}" Click="MenuCopy">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,6,0"/>
                              <TextBlock Text="{Binding CopyLabel}"/>
                            </StackPanel>
                          </Button>
                          <Button Style="{StaticResource MenuItem}" Click="MenuOpen" Visibility="{Binding HasFiles, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,6,0"/>
                              <TextBlock Text="打开所在文件夹"/>
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <TextBlock Text="暂无匹配记录" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="14,20" Padding="16" Foreground="#7C8982" FontSize="12" Visibility="{Binding EmptyVisible, Converter={StaticResource Vis}}"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding PrivacyLocked, Converter={StaticResource Vis}}">
          <Border Width="68" Height="68" CornerRadius="34" Background="#23332D" HorizontalAlignment="Center">
            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="#F4D25F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="内容已隐藏" FontSize="20" FontWeight="SemiBold" Foreground="#17201D" HorizontalAlignment="Center" Margin="0,12,0,0"/>
          <TextBlock Text="解除隐藏后继续查看最近两天的复制记录。" FontSize="13" Foreground="#7A8780" TextAlignment="Center" Width="200" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <Button Margin="0,14,0,0" Padding="13,8" HorizontalAlignment="Center" Click="TogglePrivacy" Background="#23332D" Foreground="#FFF9E8" BorderThickness="0" Cursor="Hand">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE785;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0"/>
              <TextBlock Text="显示看板" FontSize="11" FontWeight="Bold"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.RowSpan="3" Background="#99000000" Visibility="{Binding SettingsOpen, Converter={StaticResource Vis}}" MouseLeftButtonDown="CloseSettingsBackdrop">
        <Border Width="232" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Background="White" BorderBrush="#DCE2DB" BorderThickness="1" CornerRadius="12" Padding="12" MouseLeftButtonDown="SettingsCardClick">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" Foreground="#18221F" VerticalAlignment="Center"/>
              <Button Style="{StaticResource IconButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" ToolTip="关闭" Click="CloseSettings">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
              </Button>
            </DockPanel>

            <Border Background="#F7F8F5" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
              <DockPanel>
                <StackPanel>
                  <TextBlock Text="开机自启" FontSize="12" Foreground="#18221F"/>
                </StackPanel>
                <CheckBox IsChecked="{Binding AutoStart, Mode=TwoWay}" VerticalAlignment="Center" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
              </DockPanel>
            </Border>

            <Border Background="#F7F8F5" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
              <DockPanel>
                <StackPanel>
                  <TextBlock Text="显示任务栏图标" FontSize="12" Foreground="#18221F"/>
                </StackPanel>
                <CheckBox IsChecked="{Binding ShowInTaskbarSetting, Mode=TwoWay}" VerticalAlignment="Center" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
              </DockPanel>
            </Border>

            <Button Style="{StaticResource WideDangerButton}" Click="Quit" ToolTip="退出程序" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="退出程序" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
