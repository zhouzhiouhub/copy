<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Kinolincopy</AssemblyName>
    <RootNamespace>ClipboardAtlas</RootNamespace>
    <Product>Kinolincopy</Product>
    <Description>Kinolincopy — 本机 Windows 剪贴板历史看板</Description>
    <Version>0.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" />
    <Page Remove="src\App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="assets\logo64.png" />
    <EmbeddedResource Include="assets\app.ico" LogicalName="Kinolincopy.app.ico" />
  </ItemGroup>
  <Target Name="GenerateGitVersion" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\gen-version.ps1&quot; -OutFile &quot;$(MSBuildProjectDirectory)\src\VersionInfo.g.cs&quot; -PropsFile &quot;$(MSBuildProjectDirectory)\obj\GitVersion.g.props&quot;" />
  </Target>
  <Import Project="obj\GitVersion.g.props" Condition="Exists('obj\GitVersion.g.props')" />
  <Target Name="RemovePublishedAppConfig" AfterTargets="Publish">
    <Delete Files="$(PublishDir)$(TargetFileName).config" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)$(TargetFileName).config')" />
  </Target>
</Project>
